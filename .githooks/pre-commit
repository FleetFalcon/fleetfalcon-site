#!/bin/sh
# Refuse a commit that adds a blog post with no header image.
#
# The check is cheap and offline — it compares app/content.ts against app/post-images.ts and
# the files on disk. It runs only when something under app/blog or app/content.ts changed, so
# an unrelated commit pays nothing.
if git diff --cached --name-only | grep -qE '^app/(content\.ts|blog/)'; then
  if ! python3 scripts/post-images.py --check >/dev/null 2>&1; then
    echo
    echo "A blog post has no header image."
    python3 scripts/post-images.py --check 2>/dev/null | grep -v '^[0-9]*/[0-9]* posts'
    echo
    echo "  npm run images     generate the missing ones, then stage public/blog and app/post-images.ts"
    echo "  git commit --no-verify   to commit anyway"
    echo
    exit 1
  fi
fi
